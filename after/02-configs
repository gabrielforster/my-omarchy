#!/usr/bin/env bash
# Config repos and dotfiles.
#
# Every Omarchy-shipped file replaced here is backed up next to the original
# as <name>.omarchy-backup-<timestamp> first.
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ts=$(date +%Y%m%d-%H%M%S)

backup() { [[ -e $1 ]] && cp -r "$1" "$1.omarchy-backup-$ts" && echo "backed up $1"; return 0; }

# --- zsh config (submodule of the dotfiles repo, used standalone here) ------
if [[ ! -d ~/.config/zsh ]]; then
  git clone git@github.com:gabrielforster/zsh.git ~/.config/zsh
else
  echo "~/.config/zsh already present"
fi

# --- neovim ----------------------------------------------------------------
# Omarchy ships its own nvim config; move it aside along with the plugin
# state, or lazy.nvim will try to reconcile two different plugin sets.
if [[ ! -d ~/.config/nvim/.git ]]; then
  backup ~/.config/nvim && rm -rf ~/.config/nvim
  for d in ~/.local/share/nvim ~/.local/state/nvim ~/.cache/nvim; do
    [[ -d $d ]] && mv "$d" "$d.omarchy-backup-$ts"
  done
  git clone git@github.com:gabrielforster/nvim.git ~/.config/nvim
else
  echo "~/.config/nvim already a git checkout"
fi

# --- tmux ------------------------------------------------------------------
# Replaces Omarchy's config wholesale. Omarchy's binds prefix C-Space with
# C-b as prefix2; this one is C-b only. Trade-off: loses the theme-following
# colours and the `omarchy menu tmux-keybindings` popup.
backup ~/.config/tmux/tmux.conf
install -Dm644 "$repo_dir/files/tmux/tmux.conf" ~/.config/tmux/tmux.conf

# --- ghostty ---------------------------------------------------------------
# See README: this is a merge snapshot, not a pure overlay.
backup ~/.config/ghostty/config
install -Dm644 "$repo_dir/files/ghostty/config" ~/.config/ghostty/config

# --- herdr -----------------------------------------------------------------
backup ~/.config/herdr/config.toml
install -Dm644 "$repo_dir/files/herdr/config.toml" ~/.config/herdr/config.toml
sed -i "s|/home/[^/]*/\.config/scripts|$HOME/.config/scripts|g" ~/.config/herdr/config.toml

# --- helper scripts --------------------------------------------------------
mkdir -p ~/.config/scripts
install -m755 "$repo_dir"/files/scripts/*.sh ~/.config/scripts/
