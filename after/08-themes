#!/usr/bin/env bash
# Themes: the two Dark Winden variants.
#
# Omarchy merges ~/.config/omarchy/themes/<slug> over its stock themes, and a
# slug it does not ship is simply a new theme. Everything else -- Neovim,
# btop, helix, VS Code, the bar, the lock screen, Chromium -- is generated by
# Omarchy's own templates from colors.toml, so these two files are the whole
# theme.
#
# These directories are owned by this repo, so they are replaced rather than
# backed up. backgrounds/ is wiped and recopied for the same reason: extra
# wallpapers of your own belong in ~/.config/omarchy/backgrounds/<slug>/,
# which Omarchy picks up for any theme and which this script never touches.
#
# The backgrounds are drawn by files/omarchy/wallpapers.py and committed. This
# script does not render them; it only copies.
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
src_dir="$repo_dir/files/omarchy/themes"
dest_dir="$HOME/.config/omarchy/themes"

# Slugs on disk; Omarchy derives the display names by title-casing them, and
# `omarchy theme set` / `theme current` speak the display name.
THEMES=(dark-winden dark-winden-light)
THEME_NAMES=("Dark Winden" "Dark Winden Light")
DEFAULT_THEME="Dark Winden"

current=$(omarchy theme current 2>/dev/null || true)
fresh=0

echo "==> Installing themes"
for slug in "${THEMES[@]}"; do
  src="$src_dir/$slug"
  dest="$dest_dir/$slug"

  [[ -d $dest ]] || fresh=1

  # Owned by this repo: the background set is replaced whole, not merged.
  rm -rf "$dest/backgrounds"
  install -Dm644 "$src/colors.toml" "$dest/colors.toml"
  install -Dm644 "$src/icons.theme" "$dest/icons.theme"
  for bg in "$src"/backgrounds/*; do
    install -Dm644 "$bg" "$dest/backgrounds/$(basename "$bg")"
  done

  echo "  $slug ($(ls "$dest/backgrounds" | wc -l) backgrounds)"
done

# Re-apply so a colour change lands, but never move someone off a theme they
# chose on purpose. A fresh install has neither, so it gets the dark one.
mine=0
for name in "${THEME_NAMES[@]}"; do
  if [[ $current == "$name" ]]; then mine=1; fi
done

echo
if [[ $mine -eq 1 ]]; then
  echo "==> Re-applying $current to pick up any colour change"
  omarchy theme set "$current"
elif [[ $fresh -eq 1 || ${OMARCHY_THEME_APPLY:-0} == 1 ]]; then
  echo "==> Applying $DEFAULT_THEME (first install)"
  omarchy theme set "$DEFAULT_THEME"
else
  echo "==> Installed, but leaving the current theme ($current) alone"
  for name in "${THEME_NAMES[@]}"; do
    echo "    omarchy theme set \"$name\""
  done
fi

echo
omarchy theme current
