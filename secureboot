#!/usr/bin/env bash
#
# Secure Boot with custom keys, keeping Windows dual-boot working.
# Follows https://github.com/omacom/omarchy/discussions/2296
#
# NOT part of `./run` on purpose -- it lives at the repo root, and `run` only
# walks scripts/ and after/. Run it deliberately:  ./secureboot
#
# It cannot be completed in one pass. Enrolling keys requires the firmware to
# be in Setup Mode, which means clearing the UEFI keys from the BIOS by hand.
# The script stops and tells you when that is the missing piece.
#
# BEFORE STARTING, know how to disable Secure Boot in your BIOS. If a signed
# file is missed, the machine will not boot, and turning Secure Boot back off
# is the recovery path.
set -euo pipefail

die()  { echo "ERROR: $*" >&2; exit 1; }
note() { echo; echo "==> $*"; }

[[ -d /sys/firmware/efi ]] || die "not booted in UEFI mode -- Secure Boot is not applicable"

# --- Setup Mode gate ------------------------------------------------------
# Read straight from efivars so this works before sbctl is configured. The
# variable is 4 bytes of attributes followed by the value.
setup_mode=$(od -An -tu1 /sys/firmware/efi/efivars/SetupMode-* 2>/dev/null | awk '{print $NF}' | head -1)
if [[ $setup_mode != "1" ]]; then
  cat >&2 <<'MSG'

Setup Mode is NOT enabled, so custom keys cannot be enrolled yet.

Do this first, then re-run:
  1. sudo systemctl reboot --firmware-setup
  2. In the BIOS: Security -> Secure Boot -> Key Management
     - Set Secure Boot to "Custom" / "Setup Mode", or choose
       "Clear Secure Boot Keys" / "Delete All Keys" / "Erase all Secure Boot
       Settings" -- the wording differs by vendor (this board is AMI).
     - Leave Secure Boot itself DISABLED for now; it gets enabled at the end.
  3. Save and reboot back into Omarchy.

Verify with (sbctl is not installed yet, so read efivars directly):
  od -An -tu1 /sys/firmware/efi/efivars/SetupMode-* | awk '{print $NF}'
1 means Setup Mode is enabled and this script can proceed; 0 means it is not.

Re-running this script is itself a safe check -- it does nothing until Setup
Mode is enabled.
MSG
  exit 1
fi

note "Setup Mode confirmed"

note "Installing sbctl"
omarchy pkg add sbctl
sudo sbctl status

# --- btrfs-overlayfs hook -------------------------------------------------
# The guide prints a whole HOOKS= line, but that line is the *udev* initramfs
# flavour. Omarchy here uses the *systemd* flavour (systemd, sd-vconsole).
# Swapping flavours wholesale can produce an unbootable initramfs, so only
# append the one hook that is actually being added.
if grep -q '^HOOKS=.*btrfs-overlayfs' /etc/mkinitcpio.conf; then
  echo "btrfs-overlayfs hook already present"
else
  note "Adding the btrfs-overlayfs hook to /etc/mkinitcpio.conf"
  sudo cp /etc/mkinitcpio.conf "/etc/mkinitcpio.conf.bak.$(date +%Y%m%d-%H%M%S)"
  sudo sed -i -E 's/^(HOOKS=\(.*)\)$/\1 btrfs-overlayfs)/' /etc/mkinitcpio.conf
  grep '^HOOKS=' /etc/mkinitcpio.conf
fi

# Limine records a BLAKE2b hash of each boot file when it builds the images
# (ENABLE_VERIFICATION=yes). Signing happens afterwards and CHANGES those files,
# which invalidates the hashes and makes Limine warn on every boot -- and it
# recurs on every kernel update, because mkinitcpio rebuilds before sbctl's hook
# re-signs. Secure Boot verifies the UKI with the enrolled keys, so the BLAKE2b
# check is redundant here. Turn it off before building.
note "Disabling Limine's BLAKE2b verification (redundant under Secure Boot)"
if grep -qE '^\s*ENABLE_VERIFICATION=' /etc/default/limine 2>/dev/null; then
  sudo sed -i -E 's|^\s*ENABLE_VERIFICATION=.*|ENABLE_VERIFICATION=no|' /etc/default/limine
else
  echo 'ENABLE_VERIFICATION=no' | sudo tee -a /etc/default/limine >/dev/null
fi

note "Rebuilding the boot images"
sudo limine-mkinitcpio

# --- keys -----------------------------------------------------------------
if sudo sbctl list-keys &>/dev/null && [[ -n $(sudo sbctl list-keys 2>/dev/null) ]]; then
  echo "sbctl keys already exist -- skipping create-keys"
else
  note "Creating custom keys"
  sudo sbctl create-keys
fi

# -m keeps Microsoft's keys alongside the custom ones. This machine dual-boots
# Windows (an EFI entry for Windows Boot Manager exists), and Windows' loader
# is signed by Microsoft -- enrolling without -m makes Windows unbootable.
note "Enrolling keys (Microsoft keys included, for Windows)"
sudo sbctl enroll-keys -m

# --- signing --------------------------------------------------------------
note "Signing everything sbctl reports as unsigned"
sudo sbctl verify | sed -nE 's|^✗ (/.+) is not signed$|sbctl sign -s "\1"|p' | sudo sh || true

# Signing changed the files on the ESP, so regenerate limine.conf against them.
note "Regenerating limine.conf against the signed files"
sudo limine-update

note "Final verification -- every entry below must be signed"
sudo sbctl verify
sudo sbctl status

# Windows, if present, is usually on its own ESP that limine-entry-tool never
# scans -- FIND_BOOTLOADERS only looks at $ESP_PATH. Point it out rather than
# guessing the GUID.
if efibootmgr 2>/dev/null | grep -q "Windows Boot Manager" && ! grep -q "^/Windows" /boot/limine.conf; then
  # Read the ESP GUID out of the Windows EFI entry itself. Scanning for
  # unmounted vfat partitions also matches USB installers, which is how you
  # end up pointing the entry at a Ventoy stick.
  win_guid=$(efibootmgr | grep "Windows Boot Manager" | grep -oP 'HD\(\d+,GPT,\K[0-9a-f-]+' | head -1)
  cat <<MSG

NOTE: Windows has an EFI entry but no entry in limine.conf, so it will not
appear in the boot menu. Windows is on a separate ESP that limine-entry-tool
does not scan. Add this to /boot/limine.conf (verify the GUID first with
\`lsblk -o NAME,SIZE,FSTYPE,PARTUUID\`):

/Windows
comment: order-priority=20
protocol: efi
path: guid(${win_guid:-<windows-esp-partuuid>}):/EFI/Microsoft/Boot/bootmgfw.efi

MSG
fi

cat <<'MSG'

Done, except for the firmware step.

  sudo systemctl reboot --firmware-setup

Enable Secure Boot in the BIOS, save, and boot back in. Confirm with:

  sudo sbctl status      # Secure Boot: Enabled
  bootctl status | grep -i "secure boot"

If the machine will not boot, go back into the BIOS and disable Secure Boot.
That restores the previous behaviour; nothing here is destructive to the
installed system.
MSG
